{
  "name": "@locus/extension",
  "description": "Twitter and Bilibili capture, retained results, and JSON/file export",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "test": "vitest run",
    "test:browser:locus": "node testing/locus-browser-smoke.mjs",
    "test:browser": "node testing/browser-smoke.mjs",
    "test:browser:bilibili": "node testing/bilibili-smoke.mjs",
    "test:browser:performance": "node testing/capture-performance.mjs --verify-concurrency",
    "probe:bilibili-media": "node testing/bilibili-media-probe/run.mjs",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@locus/capture-core": "workspace:*",
    "@locus/twitter": "workspace:*",
    "@zip.js/zip.js": "^2.15.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "lucide-react": "^1.44.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "@locus/bilibili": "workspace:*",
    "mediabunny": "1.58.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/chrome": "^0.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "^1.1.5",
    "fake-indexeddb": "^6.2.5",
    "oxlint": "1.82.0",
    "playwright-core": "^1.63.0",
    "shadcn": "^4.21.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "8.1.5",
    "vitest": "5.0.0",
    "web-ext": "10.5.0",
    "wxt": "0.21.4"
  }
}
